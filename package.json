{
  "name": "ima-qa-web",
  "version": "0.2.2",
  "description": "IMA shared knowledge base QA gateway with streaming Web Agent answers, isolated conversations, and encrypted account-pool enrollment.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/19Chris19/ima-qa-web-agent.git"
  },
  "bugs": {
    "url": "https://github.com/19Chris19/ima-qa-web-agent/issues"
  },
  "homepage": "https://github.com/19Chris19/ima-qa-web-agent#readme",
  "main": "provider-a-server.js",
  "files": [
    "assets",
    "docs",
    "eval",
    "public",
    "scripts",
    "src",
    "test",
    ".dockerignore",
    ".env.example",
    ".env.provider-a.example",
    "CHANGELOG.md",
    "compose.yaml",
    "Dockerfile",
    "LICENSE",
    "provider-a-server.js",
    "README.md",
    "server.js"
  ],
  "scripts": {
    "eval:dry-run": "node eval/run-eval.mjs --dry-run",
    "eval:run": "node eval/run-eval.mjs",
    "test:concurrency": "node scripts/test-concurrency.mjs",
    "setup:provider-a": "node scripts/setup-provider-a.mjs",
    "admin:enroll": "node scripts/enroll-web-agent-account.mjs",
    "admin:seal-runtime": "node scripts/seal-legacy-runtime-exports.mjs",
    "local-rag:index": "node scripts/build-local-rag-index.mjs",
    "start": "node provider-a-server.js",
    "dev": "node --watch provider-a-server.js",
    "test": "node --test"
  },
  "keywords": [
    "ima",
    "knowledge-base",
    "qa",
    "mimo",
    "streaming"
  ],
  "license": "MIT",
  "overrides": { "qs": "^6.16.0" },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.62.1"
  },
  "engines": {
    "node": ">=18.18"
  }
}
