# Provider A only. Copy to .env, then replace the shared knowledge base ID.
# Do not add browser cookies, refresh tokens, or any MIMO/OpenAPI credentials here.
IMA_QA_PROVIDER=ima-web-agent
PORT=3000
HOST_PORT=3117
# Keep the container behind Nginx by default. Change only for controlled direct exposure.
HOST_BIND=127.0.0.1

# The numeric ID from the IMA Web shared knowledge base URL. It is not an OpenAPI ID.
IMA_WEB_AGENT_SHARED_KNOWLEDGE_BASE_ID=your_ima_web_numeric_kb_id
IMA_WEB_AGENT_MODEL_ID=official_3
IMA_WEB_AGENT_MODEL_TYPE=3
# Required for management-page QR enrollment. Point at a browser executable on
# the same maintenance machine that runs Node; it is not a browser profile path.
# IMA_WEB_AGENT_BROWSER_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# IMA_WEB_AGENT_ENROLLMENT_TIMEOUT_MS=300000
# IMA_WEB_AGENT_ENROLLMENT_SCREENSHOT_INTERVAL_MS=900
# IMA_WEB_AGENT_ENROLLMENT_BROWSER_LAUNCH_TIMEOUT_MS=75000
# visible (default) opens an isolated login window and closes it after enrollment.
# Use background only for compatibility diagnosis.
# IMA_WEB_AGENT_ENROLLMENT_BROWSER_MODE=visible

# Private state. runtime/ must be mounted to persistent private storage and never committed.
IMA_WEB_AGENT_ACCOUNT_STORE_PATH=./runtime/ima-web-agent-accounts.json
IMA_WEB_AGENT_ACCOUNT_STORE_KEY_PATH=./runtime/ima-web-agent-accounts.key
IMA_QA_CONVERSATION_STORE_PATH=./runtime/ima-qa-conversations.json
IMA_QA_CONVERSATION_TTL_MS=604800000
# Private, sanitized capacity and answer-quality exercise reports. Never commit runtime/.
# IMA_QA_EXERCISE_REPORT_STORE_PATH=./runtime/ima-qa-account-pool-exercises.json
# IMA_QA_EXERCISE_REPORT_TTL_MS=604800000
# IMA_QA_EXERCISE_REPORT_MAX_COUNT=30

# Generate a unique random value before deployment. The setup wizard does this automatically.
IMA_QA_ADMIN_TOKEN=replace_with_a_long_random_admin_token
# Leave empty for the bundled same-origin chat page.
# IMA_QA_API_TOKEN=
# Required only when the optional VoiceRAG service uses Provider A for private deep search.
# This must differ from IMA_QA_ADMIN_TOKEN and is never sent to browsers.
# IMA_QA_INTERNAL_SERVICE_TOKEN=
# Empty means same-origin only. Add exact origins to allow an external iframe or frontend API call.
ALLOWED_ORIGINS=
TRUST_PROXY=false
IMA_QA_HEALTH_DETAILS=basic

# One active ask per IMA account is the stable baseline.
# Auto mode follows enabled account count without restarting the service.
IMA_QA_ACCOUNT_POOL_CAPACITY_MODE=auto
IMA_QA_MAX_CONCURRENT_ASK=auto
IMA_QA_QUEUE_LIMIT=30
IMA_QA_REQUEST_TIMEOUT_MS=180000
IMA_QA_RATE_LIMIT_WINDOW_MS=60000
IMA_QA_RATE_LIMIT_MAX=20
# A management-page session check uses only init_session, never a knowledge-base question.
IMA_WEB_AGENT_HEALTH_CHECK_TIMEOUT_MS=15000
IMA_WEB_AGENT_REFRESH_SKEW_MS=600000
IMA_WEB_AGENT_REFRESH_INTERVAL_MS=60000
